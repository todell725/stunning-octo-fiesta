{
  "name": "invoice-tracker-server",
  "version": "1.0.0",
  "description": "Invoice tracker backend with OCR and full-text search",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node src/seed.ts",
    "db:reset": "prisma migrate reset --force && ts-node src/seed.ts",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@prisma/client": "^5.14.0",
    "@types/uuid": "^10.0.0",
    "csv-stringify": "^6.5.0",
    "dayjs": "^1.11.11",
    "dotenv": "^17.4.0",
    "fastify": "^4.28.1",
    "pino-pretty": "^11.2.1",
    "sharp": "^0.33.4",
    "tesseract.js": "^5.1.0",
    "uuid": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.2"
  }
}
